#!/system/bin/sh
# Solar Y1 button script (patched from rockbox-y1).
# 1. Restart Rockbox when prev+next held 10s while Rockbox is running.
# 2. Back+Play held 10s toggles Solar ↔ Rockbox (no full restart, unified keymap).

BOOT_COMPLETED=0
while [ "$BOOT_COMPLETED" -ne 1 ]; do
    BOOT_COMPLETED=$(getprop sys.boot_completed)
    sleep 1
done

settings put system sound_effects_enabled 0

# 2026-07-08 — Seed switch + executor on every boot (overwrite stale /data copies).
# Rockbox only calls /data/data/switch-to-stock.sh; that script needs solar-launcher-exec nearby.
# Reversal: seed switch-to-stock/rockbox only (legacy inline path then runs without gates).
if [ -f /system/etc/solar/switch-to-stock.sh ]; then
    cp /system/etc/solar/switch-to-stock.sh /data/data/
    chmod 755 /data/data/switch-to-stock.sh
fi
if [ -f /system/etc/solar/switch-to-rockbox.sh ]; then
    cp /system/etc/solar/switch-to-rockbox.sh /data/data/
    chmod 755 /data/data/switch-to-rockbox.sh
fi
if [ -f /system/etc/solar/solar-launcher-exec.sh ]; then
    cp /system/etc/solar/solar-launcher-exec.sh /data/data/
    chmod 755 /data/data/solar-launcher-exec.sh
fi

DEVICE="/dev/input/event2"
MAX_HOLD=10
MAX_HOLD_DUAL_BOOT=10

if [ ! -e "$DEVICE" ]; then
    exit 1
fi


left_down=0
right_down=0
menu_down=0
play_down=0
press_start_sec=0
press_start_sec_dual_boot=0

package_rb="org.rockbox"
package_solar="com.solar.launcher"

restart_rockbox() {
    am force-stop org.rockbox
    am start -n org.rockbox/.RockboxActivity
}

# 2026-07-10 — Solar-only: Back+Play 10s launcher toggle disabled (no Rockbox handoff).
launcher_handoff() {
    echo "Solar-only ROM — launcher handoff disabled."
}

# 2026-09-14 — Idle CPU fix. The old loop ran `dumpsys power | grep` on EVERY iteration and
# did not sleep when the screen was off, so with the screen off it spun forking
# dumpsys+grep continuously (~100 forks/s, load ~7 on an idle Y1); with the screen on it
# forked dumpsys+grep+dd+xxd plus sed+awk per parsed field (~14 forks per wheel tick).
# Now: dd blocks on the input device (no spin), fields are parsed with parameter expansion
# (no forks), and the screen state is only consulted when a hold combo actually completes.
# Was: dumpsys gate before every read; reverse_bytes() via sed|awk per field.
screen_on() {
    dumpsys power 2>/dev/null | grep -q "mScreenOn=true"
}
while true; do
    event_bytes=$(dd if="$DEVICE" bs=16 count=1 2>/dev/null | xxd -p)
    [ -z "$event_bytes" ] && break
    # struct input_event (32-bit): sec[4] usec[4] type[2] code[2] value[4], little-endian.
    sec_hex="${event_bytes:6:2}${event_bytes:4:2}${event_bytes:2:2}${event_bytes:0:2}"
    type_hex="${event_bytes:18:2}${event_bytes:16:2}"
    code_hex="${event_bytes:22:2}${event_bytes:20:2}"
    value_hex="${event_bytes:30:2}${event_bytes:28:2}${event_bytes:26:2}${event_bytes:24:2}"
    sec=$((0x$sec_hex))
    type=$((0x$type_hex))
    value=$((0x$value_hex))
    code=$((0x$code_hex))
    {
        if [ "$type" -eq 1 ]; then
            case "$code" in
                164)
                    play_down=$value
                    left_down=0
                    right_down=0
                    ;;
                158)
                    menu_down=$value
                    left_down=0
                    right_down=0
                    ;;
                105)
                    left_down=$value
                    play_down=0
                    menu_down=0
                    ;;
                106)
                    right_down=$value
                    play_down=0
                    menu_down=0
                    ;;
                *)
                    play_down=0
                    menu_down=0
                    left_down=0
                    right_down=0
                    ;;
            esac

            if [ "$left_down" -eq 1 ] && [ "$right_down" -eq 1 ] && [ "$press_start_sec" -eq 0 ]; then
                press_start_sec=$sec
            fi

            if [ "$menu_down" -eq 1 ] && [ "$play_down" -eq 1 ] && [ "$press_start_sec_dual_boot" -eq 0 ]; then
                press_start_sec_dual_boot=$sec
            fi

            if [ "$press_start_sec" -ne 0 ]; then
                if [ "$left_down" -eq 0 ] || [ "$right_down" -eq 0 ]; then
                    hold_time=$((sec - press_start_sec))
                    if [ "$hold_time" -ge "$MAX_HOLD" ] && screen_on && pm list packages -e | grep -q "$package_rb"; then
                        restart_rockbox
                    fi
                    press_start_sec=0
                fi
            fi

            if [ "$press_start_sec_dual_boot" -ne 0 ]; then
                if [ "$menu_down" -eq 0 ] || [ "$play_down" -eq 0 ]; then
                    hold_time=$((sec - press_start_sec_dual_boot))
                    if [ "$hold_time" -ge "$MAX_HOLD_DUAL_BOOT" ] && screen_on; then
                        launcher_handoff
                    fi
                    press_start_sec_dual_boot=0
                fi
            fi
        fi
    }
done
